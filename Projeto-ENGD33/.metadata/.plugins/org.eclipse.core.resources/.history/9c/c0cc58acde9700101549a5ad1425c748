#include "GY-87.h"
#include "main.h"
#include <math.h>

void Configure_Compass(void)
{
	uint8_t Reg_A_Config;
	uint8_t Reg_B_Config;
	uint8_t Reg_MODE_Config;

	Reg_A_Config = (HMC5883L_AVERAGING_1 |  HMC5883L_RATE_15 | HMC5883L_BIAS_NORMAL);
	Reg_B_Config = (HMC5883L_GAIN_660);
	Reg_MODE_Config = (HMC5883L_I2C_SPEED_4OOKHZ | HMC5883L_MODE_CONTINUOUS);
	HAL_FMPI2C_Mem_Write(&hi2c1,HMC5883L_ADDRESS,HMC5883L_REG_CONFIG_A,1,&Reg_A_Config,1,3);
	HAL_FMPI2C_Mem_Write(&hi2c1,HMC5883L_ADDRESS,HMC5883L_REG_CONFIG_B,1,&Reg_B_Config,1,3);
	HAL_FMPI2C_Mem_Write(&hi2c1,HMC5883L_ADDRESS,HMC5883L_REG_MODE,1,&Reg_MODE_Config,1,3);
}

uint8_t Read_Compass_Status_Register(void)
{
	uint8_t Status;
	HAL_FMPI2C_Mem_Read(&hi2c1,HMC5883L_ADDRESS,HMC5883L_REG_STATUS,1,&Status,1,3);
	return Status;
}

float Read_Compass(float bias)
{
	uint8_t buffer[6];
	uint16_t x, y;
	float angle, angle_zero;

	if (HAL_GPIO_ReadPin(GPIOC, IMU_DRDY_GPIO_PC13_Pin) = 1)
	{
		angle_zero = bias;
		HAL_FMPI2C_Mem_Read(&hi2c1,HMC5883L_ADDRESS,HMC5883L_REG_DATAX_H,1,&buffer,6,2);
		x = ((buffer[0]<<8) | buffer[1]);
		/*z = ((buffer[2]<<8) | buffer[3])/660.0f;*/
		y = ((buffer[4]<<8) | buffer[5]);
		angle = (atan2(((float) y), ((float) x)) * 57.2957795131) + angle_zero; // (180.0f / M_PI)
	}
	else
	{

	}

	return angle;
}

void Configure_Giroscope_and_Accelerometer(void)
{
	uint8_t Reg_Config;
	uint8_t Reg_Giro_Config;
	uint8_t Reg_Accel_Config;
	uint8_t Reg_Pwr_Mgmt_1;

	Reg_Pwr_Mgmt_1 = (MPU6050_DEVICE_RESET);
	Reg_Config = (EXT_SYNC_SET_DISABLED | EXT_SYNC_DLPF_CFG_1K_180B);
	Reg_Giro_Config =  (GYRO_FULL_SCALE_1000);
	Reg_Accel_Config = (ACCEL_FULL_SCALE_2G);
	HAL_FMPI2C_Mem_Write(&hi2c1,MPU6050_ADDRESS,MPU6050_PWR_MGMT_1,1,&Reg_Pwr_Mgmt_1,1,3);
	HAL_FMPI2C_Mem_Write(&hi2c1,MPU6050_ADDRESS,MPU6050_CONFIG_REG,1,&Reg_Config,1,3);
	HAL_FMPI2C_Mem_Write(&hi2c1,MPU6050_ADDRESS,MPU6050_GYRO_CONFIG,1,&Reg_Giro_Config,1,3);
	HAL_FMPI2C_Mem_Write(&hi2c1,MPU6050_ADDRESS,MPU6050_ACCEL_CONFIG,1,&Reg_Accel_Config,1,3);
}

Cartesian3D Read_Accelerometer(void)
{
	uint8_t buffer[6];
	Cartesian3D acceleration;

	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_ACCEL_XOUT_H,1,&buffer[0],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_ACCEL_XOUT_L,1,&buffer[1],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_ACCEL_YOUT_H,1,&buffer[2],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_ACCEL_YOUT_L,1,&buffer[3],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_ACCEL_ZOUT_H,1,&buffer[4],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_ACCEL_ZOUT_l,1,&buffer[5],1,1);
	acceleration.x = ((float)((buffer[0]<<8) | buffer[1]))*19.62;
	acceleration.y = ((float)((buffer[2]<<8) | buffer[3]))*19.62;
	acceleration.z = ((float)((buffer[4]<<8) | buffer[5]))*19.62;
	return acceleration;
}

Cartesian3D Read_Giroscope(void)
{
	uint8_t buffer[6];
	Cartesian3D giro;

	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_GYRO_XOUT_H,1,&buffer[0],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_GYRO_XOUT_L,1,&buffer[1],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_GYRO_YOUT_H,1,&buffer[2],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_GYRO_YOUT_L,1,&buffer[3],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_GYRO_ZOUT_H,1,&buffer[4],1,1);
	HAL_FMPI2C_Mem_Read(&hi2c1,MPU6050_ADDRESS, MPU6050_GYRO_ZOUT_l,1,&buffer[5],1,1);
	giro.x = ((float)((buffer[0]<<8) | buffer[1]));
	giro.y = ((float)((buffer[2]<<8) | buffer[3]));
	giro.z = ((float)((buffer[4]<<8) | buffer[5]));
	return giro;
}



